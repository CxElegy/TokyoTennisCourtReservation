# Copy to .env (never commit .env). In GitHub Actions / cloud environments, set these as
# environment variables or Secrets instead.

# --- えどねっと login (利用者ID / パスワード) ---
EDOGAWA_USER_ID=12345678
EDOGAWA_PASSWORD=your-password

# --- Browser (optional) ---
# Path to a preinstalled Chromium. In the Claude Code cloud container use:
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
PLAYWRIGHT_CHROMIUM_PATH=

# --- Notifiers (set only the ones you use) ---
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
